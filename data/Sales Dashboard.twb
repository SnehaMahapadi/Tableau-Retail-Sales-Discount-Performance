      <aliases enabled='yes' />
      <column caption='Profit Margin %' datatype='real' name='[Calculation_0953591952068608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit]) / SUM([sales])' />
      </column>
      <column caption='Subcategory + Segment' datatype='string' name='[Calculation_0953592030265345]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[product_subcategory] + &quot; - &quot; + [customer_segment]' />
      </column>
      <column caption='Order Profit Margin' datatype='real' name='[Calculation_0953592037449730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[profit] / [sales]' />
      </column>
      <column caption='Discount Band' datatype='string' name='[Calculation_0953592037629955]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [discount] = 0 THEN &quot;No Discount&quot; ELSEIF [discount] &lt;= 0.10 THEN &quot;1-10%&quot; ELSEIF [discount] &lt;= 0.20 THEN &quot;11-20%&quot; ELSE &quot;21%+&quot; END' />
      </column>
      <column aggregation='Min' caption='Jitter Seed' datatype='real' name='[Calculation_0953592040271876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANDOM()' />
      </column>
      <column caption='Jitter Discount' datatype='real' name='[Calculation_0953592040890373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([discount]) + (MIN([Calculation_0953592040271876]) - 0.5) * 0.03' />
      </column>
      <column caption='Margin %' datatype='real' name='[Calculation_0953592042635271]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit]) / SUM([sales])' />
      </column>
