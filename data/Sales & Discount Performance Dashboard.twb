              <calculation class='tableau' formula='IF [discount] = 0 THEN &quot;No Discount&quot; ELSEIF [discount] &lt;= 0.10 THEN &quot;1-10%&quot; ELSEIF [discount] &lt;= 0.20 THEN &quot;11-20%&quot; ELSE &quot;21%+&quot; END' />
